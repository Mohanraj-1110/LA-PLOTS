# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/la_plots?retryWrites=true&w=majority

# Backend Server Port
PORT=5000

# Firebase Authentication Credentials (used by Vite frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Email Whitelist (comma-separated)
# Only these emails receive admin role automatically
VITE_ADMIN_EMAILS=admin@yourdomain.com
ADMIN_EMAILS=admin@yourdomain.com

# Firebase Admin SDK — required by the server auth middleware (BUG-01 fix)
# Must match VITE_FIREBASE_PROJECT_ID above
FIREBASE_PROJECT_ID=your_project_id
# Optional: path to a service account JSON key file for stronger admin verification
# If omitted, the middleware uses Application Default Credentials (works on GCP/Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# CORS allowed origin — set to your production frontend URL (BUG-16 fix)
# Default: http://localhost:5173
ALLOWED_ORIGIN=https://yourdomain.com
